{
  "expo": {
    "name": "Emmmenta",
    "slug": "emmmenta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBE5D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Emmmenta usa a tua localização para mostrar os pratos do dia dos restaurantes perto de ti. A localização não é guardada."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Emmmenta precisa de acesso às fotografias para escolheres a foto do teu restaurante.",
          "cameraPermission": "A Emmmenta precisa da câmara para tirares a foto do teu restaurante."
        }
      ],
      "expo-font"
    ],
    "scheme": "emmmenta"
  }
}
